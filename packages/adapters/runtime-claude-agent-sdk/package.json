{
  "name": "@poke/runtime-claude-agent-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Agent SDK runtime for Poke and side chats (subscription auth).",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@poke/domain": "workspace:*",
    "@poke/agent-core": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "0.3.332",
    "zod": "4.6.7"
  }
}
