# Honcho {{honcho_version}} configuration, rendered by `poke memory setup` into
# ~/poke/services/honcho.env (0600). It holds secrets: never copy it into git.
# Key names checked against Honcho v3.6.2's config (src/config.py, .env.template).

DB_CONNECTION_URI=postgresql+psycopg://honcho:{{postgres_password}}@postgres:5432/honcho
CACHE_ENABLED=true
CACHE_URL=redis://redis:6379/0

AUTH_USE_AUTH=true
AUTH_JWT_SECRET={{jwt_secret}}

# Every model call goes to Poke's model gateway, which serves the Memory models
# chosen with `poke model`. The model names are aliases the gateway ignores.
LLM_OPENAI_API_KEY={{gateway_key}}

DERIVER_ENABLED=true
DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__MODEL=poke-memory
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL={{gateway_url}}
DERIVER_MODEL_CONFIG__STRUCTURED_OUTPUT_MODE=json_object

{{#dialectic_levels}}
DIALECTIC_LEVELS__{{level}}__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__{{level}}__MODEL_CONFIG__MODEL=poke-memory
DIALECTIC_LEVELS__{{level}}__MODEL_CONFIG__OVERRIDES__BASE_URL={{gateway_url}}
{{/dialectic_levels}}

SUMMARY_ENABLED=true
SUMMARY_MODEL_CONFIG__TRANSPORT=openai
SUMMARY_MODEL_CONFIG__MODEL=poke-memory
SUMMARY_MODEL_CONFIG__OVERRIDES__BASE_URL={{gateway_url}}

DREAM_ENABLED=true
DREAM_DEDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_DEDUCTION_MODEL_CONFIG__MODEL=poke-memory
DREAM_DEDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL={{gateway_url}}
DREAM_INDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_INDUCTION_MODEL_CONFIG__MODEL=poke-memory
DREAM_INDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL={{gateway_url}}

PEER_CARD_ENABLED=true

# Embeddings: Voyage through the gateway, always {{dimensions}} floats. The vector column is
# sized once, on the empty database, by scripts/configure_embeddings.py.
EMBED_MESSAGES=true
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__MODEL=poke-embed
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL={{gateway_url}}
EMBEDDING_MODEL_CONFIG__DIMENSIONS_MODE=never
EMBEDDING_MODEL_CONFIG__ENCODING_FORMAT_MODE=float
EMBEDDING_VECTOR_DIMENSIONS={{dimensions}}
