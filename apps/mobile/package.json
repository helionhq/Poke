{
  "name": "@poke/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Poke for iPhone (Expo).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "export": "expo export --platform ios"
  },
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "0.4.1",
    "@noble/ed25519": "3.2.0",
    "@noble/hashes": "2.4.0",
    "@poke/blocks": "workspace:*",
    "@poke/client": "workspace:*",
    "@poke/contracts": "workspace:*",
    "@poke/ui-native": "workspace:*",
    "@poke/ui-tokens": "workspace:*",
    "expo": "58.1.0",
    "expo-background-task": "~58.0.13",
    "expo-blur": "~58.0.6",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.9",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.15",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.6",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.19",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-media-library": "~58.0.14",
    "expo-notifications": "~58.1.10",
    "expo-router": "~58.0.33",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.24",
    "expo-speech": "~58.0.4",
    "expo-splash-screen": "~58.0.15",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.23",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.3",
    "jest": "30.5.2",
    "jest-expo": "~58.0.16",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo/ios",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.test.ts?(x)",
      "<rootDir>/app/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@noble/.*|@poke/.*|react-native-svg))"
    ]
  }
}
