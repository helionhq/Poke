{
  "name": "@poke/cli",
  "version": "0.1.0",
  "private": true,
  "description": "The `poke` command: setup, login, config, model, status, update, doctor, logs.",
  "type": "module",
  "bin": {
    "poke": "./dist/main.js"
  },
  "exports": {
    ".": {
      "@poke/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@poke/domain": "workspace:*",
    "@poke/contracts": "workspace:*",
    "@poke/client": "workspace:*",
    "@poke/server": "workspace:*",
    "@poke/application": "workspace:*",
    "@clack/prompts": "1.9.0",
    "commander": "15.1.0",
    "qrcode-terminal": "0.12.0",
    "picocolors": "1.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/qrcode-terminal": "0.12.2"
  }
}
